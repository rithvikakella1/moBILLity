---
/**
 * Shell for sign-in, sign-up, and account-recovery pages.
 *
 * Replaces static/auth.css, whose palette had drifted from the rest of the app
 * (its own --teal, its own --muted at 4.45:1 which failed AA). It now draws
 * from the shared tokens.
 */
import Base from "./Base.astro";

export interface Props {
  title: string;
  heading: string;
  intro: string;
}

const { title, heading, intro } = Astro.props;
---

<Base title={title} bare>
  <main class="wrap" id="main">
    <a class="logo" href="/">mo<span>BILL</span>ity</a>
    <section class="card">
      <h1>{heading}</h1>
      <p class="intro">{intro}</p>
      <div id="alert" class="alert" role="alert" aria-live="assertive"></div>
      <slot />
    </section>
    <p class="footer"><slot name="footer" /></p>
  </main>
</Base>

<style>
  body {
    display: grid;
    place-items: center;
    padding: 32px 18px;
    background:
      radial-gradient(circle at 75% 15%, rgba(0, 191, 166, 0.14), transparent 35%),
      var(--cream);
  }

  .wrap {
    width: min(440px, 100%);
  }

  .logo {
    display: block;
    margin: 0 0 24px;
    text-align: center;
    color: var(--navy);
    text-decoration: none;
    font: 34px var(--font-display);
  }
  .logo span {
    color: var(--teal-text);
  }

  .card {
    padding: 34px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 22px;
    box-shadow: 0 20px 60px rgba(10, 22, 40, 0.1);
  }

  h1 {
    margin: 0 0 8px;
    font: 34px var(--font-display);
    font-weight: 400;
  }

  .intro {
    margin: 0 0 26px;
    color: var(--muted);
    line-height: 1.55;
  }

  .footer {
    text-align: center;
    margin-top: 20px;
    font-size: 14px;
  }
</style>

<style is:global>
  /* Form controls shared by every auth page. Global because the markup is
     supplied through <slot /> by the individual pages. */
  .alert {
    display: none;
    margin: 0 0 18px;
    padding: 11px 13px;
    border-radius: 10px;
    font-size: 14px;
    line-height: 1.4;
  }
  .alert.show {
    display: block;
  }
  .alert.error {
    background: #fff0f0;
    color: var(--danger);
  }
  .alert.success {
    background: #e9fbf5;
    color: #087f5b;
  }

  .auth-form label {
    display: block;
    margin: 16px 0 7px;
    font-size: 13px;
    font-weight: 700;
  }

  .input {
    width: 100%;
    padding: 13px 14px;
    border: 1px solid var(--border);
    border-radius: 11px;
    font: inherit;
    background: var(--white);
    color: var(--navy);
  }
  .input:focus-visible {
    outline: 3px solid var(--teal-text);
    outline-offset: 1px;
    border-color: var(--teal-text);
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .link {
    color: var(--teal-text);
    font-weight: 650;
    text-decoration: none;
    font-size: 14px;
  }
  .link:hover {
    text-decoration: underline;
  }

  .button,
  .google {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 20px;
    padding: 13px;
    border-radius: 999px;
    font: 700 15px var(--font-body);
    cursor: pointer;
    text-decoration: none;
  }
  .button {
    border: 0;
    background: var(--navy);
    color: var(--white);
  }
  .button:hover {
    background: var(--navy-mid);
  }
  .button:disabled {
    opacity: 0.55;
    cursor: wait;
  }
  .google {
    border: 1px solid var(--border);
    background: var(--white);
    color: var(--navy);
  }
  .google:hover {
    border-color: var(--teal-text);
  }
  .google-mark {
    font-weight: 800;
    color: #4285f4;
  }

  .divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 22px 0;
    color: var(--muted);
    font-size: 12px;
  }
  .divider::before,
  .divider::after {
    content: "";
    height: 1px;
    flex: 1;
    background: var(--border);
  }

  .fine {
    margin: 22px 0 0;
    font-size: 12px;
    text-align: center;
    color: var(--muted);
  }
  .requirements {
    font-size: 12px;
    margin: 7px 0 0;
    color: var(--muted);
  }

  @media (max-width: 500px) {
    .card {
      padding: 26px 22px;
    }
    .row {
      align-items: flex-start;
      flex-direction: column;
      gap: 5px;
    }
  }
</style>
