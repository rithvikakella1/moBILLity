---
import Auth from "../layouts/Auth.astro";
---

<Auth
  title="Choose password · moBILLity"
  heading="Choose a new password"
  intro="This link is single-use and expires after one hour."
>
  <form id="form" class="auth-form">
    <label for="password">New password</label>
    <input
      class="input"
      id="password"
      type="password"
      autocomplete="new-password"
      minlength="12"
      maxlength="128"
      required
    />
    <p class="requirements">Use 12–128 characters.</p>
    <label for="confirm">Confirm password</label>
    <input class="input" id="confirm" type="password" autocomplete="new-password" required />
    <button class="button" id="submit" type="submit">Update password</button>
  </form>
  <p slot="footer"><a class="link" href="/login">Back to sign in</a></p>
</Auth>

<script>
  import { showAlert, payload, onSubmit, linkToken } from "../lib/forms.js";

  onSubmit("#form", async (form) => {
    const password = (document.querySelector("#password") as HTMLInputElement).value;
    if (password !== (document.querySelector("#confirm") as HTMLInputElement).value) {
      throw new Error("Passwords do not match.");
    }
    const response = await fetch("/api/reset-password", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ token: linkToken(), password }),
    });
    const data = await payload(response);
    showAlert(data.message || data.detail, response.ok ? "success" : "error");
    if (response.ok) (form as HTMLFormElement).reset();
  });
</script>
