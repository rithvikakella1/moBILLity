---
import Base from "../layouts/Base.astro";
import AppNav from "../components/AppNav.astro";
import DataTable from "../components/DataTable.astro";
---

<Base title="moBILLity — Clinical Workflow Hub">
  <AppNav slot="nav" active="workflows" />

  <main id="main">
    <div class="eyebrow">Clinical operations</div>
    <h1>Workflow <em>Hub</em></h1>
    <p class="intro">
      Coordinate patient outreach from one queue. Consented patients are reminded a week before
      their visit by text, phone, or email — or a day before when the visit is booked inside that
      window.
    </p>
    <div class="mode"><span class="dot"></span><span id="deliveryMode">Preview delivery</span></div>

    <section class="stats">
      <div class="stat"><strong id="patientCount">0</strong><span>Patients</span></div>
      <div class="stat"><strong id="appointmentCount">0</strong><span>Upcoming appointments</span></div>
      <div class="stat"><strong id="pendingCount">0</strong><span>Reminders queued</span></div>
      <div class="stat"><strong id="sentCount">0</strong><span>Messages sent</span></div>
    </section>

    <div class="grid">
      <aside>
        <section class="panel">
          <h2>Add a patient</h2>
          <p class="sub">Record explicit consent separately for each channel.</p>
          <form id="patientForm">
            <label for="name">Patient name</label>
            <input id="name" required autocomplete="off" />
            <label for="phone">Phone</label>
            <input id="phone" type="tel" placeholder="+1 555 555 0123" />
            <label for="email">Email</label>
            <input id="email" type="email" placeholder="patient@example.com" />
            <label for="timezone">Timezone</label>
            <select id="timezone">
              <option value="America/New_York">Eastern</option>
              <option value="America/Chicago">Central</option>
              <option value="America/Denver">Mountain</option>
              <option value="America/Phoenix">Arizona</option>
              <option value="America/Los_Angeles">Pacific</option>
              <option value="America/Anchorage">Alaska</option>
              <option value="Pacific/Honolulu">Hawaii</option>
            </select>
            <fieldset class="consent">
              <legend>Outreach consent</legend>
              <div class="checks">
                <label class="check"><input id="smsConsent" type="checkbox" />SMS</label>
                <label class="check"><input id="voiceConsent" type="checkbox" />Voice</label>
                <label class="check"><input id="emailConsent" type="checkbox" />Email</label>
              </div>
            </fieldset>
            <button class="primary" type="submit">Save patient</button>
          </form>
        </section>

        <section class="panel">
          <h2>Schedule a visit</h2>
          <p class="sub">
            Consented channels are queued automatically. Phone reminders are held outside
            8pm–8am in the patient's local time.
          </p>
          <form id="appointmentForm">
            <label for="patient">Patient</label>
            <select id="patient" required><option value="">Choose a patient</option></select>
            <label for="startsAt">Date and time</label>
            <input id="startsAt" type="datetime-local" required />
            <div class="row2">
              <div><label for="clinician">Clinician</label><input id="clinician" /></div>
              <div><label for="location">Location</label><input id="location" /></div>
            </div>
            <button class="primary" type="submit">Schedule &amp; queue reminders</button>
          </form>
        </section>
      </aside>

      <div>
        <div class="callout">
          <div class="phone" aria-hidden="true">☎</div>
          <div>
            <b>Inbound call routing is ready</b>
            <small>
              Patients can describe what they need. Billing, insurance, records, referrals,
              complaints, manager requests, or pressing zero route to the front desk.
            </small>
          </div>
        </div>

        <DataTable
          title="Front desk queue"
          sub="Callers waiting for a call back. Resolve an entry once you have reached them."
          caption="Callers waiting for a front desk call back"
          columns={["Caller", "Reason", "Received", "Status", "Action"]}
          bodyId="handoffs"
        />
        <DataTable
          title="Upcoming care"
          sub="Appointments and their current workflow status."
          caption="Scheduled appointments"
          columns={["Patient", "Visit", "Clinician", "Location", "Status"]}
          bodyId="appointments"
        />
        <DataTable
          title="Reminder queue"
          sub="Every delivery attempt is channel-specific and auditable."
          caption="Queued and completed reminder deliveries"
          columns={["Patient", "Channel", "Send at", "Visit", "Status"]}
          bodyId="reminders"
        />
        <DataTable
          title="Communication activity"
          caption="Inbound and outbound communication history"
          columns={["Patient", "Channel", "Outcome", "Detail", "Time"]}
          bodyId="events"
        />
      </div>
    </div>
  </main>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>
</Base>

<script>
  import { api, esc, when } from "../lib/api.js";

  const $ = (selector: string) => document.querySelector(selector) as HTMLElement;
  const value = (selector: string) => (document.querySelector(selector) as HTMLInputElement).value;
  const checked = (selector: string) =>
    (document.querySelector(selector) as HTMLInputElement).checked;

  let state: any = {
    patients: [], appointments: [], reminders: [], events: [], handoffs: [],
  };

  function notify(message: string, isError = false) {
    const toast = $("#toast");
    toast.textContent = message;
    toast.className = "toast" + (isError ? " error" : "");
    toast.style.display = "block";
    setTimeout(() => (toast.style.display = "none"), 3500);
  }

  const rows = (items: any[], render: (item: any) => string, columns: number) =>
    items.length
      ? items.map(render).join("")
      : `<tr><td colspan="${columns}" class="empty">Nothing here yet.</td></tr>`;

  function render() {
    $("#patientCount").textContent = state.patients.length;
    $("#appointmentCount").textContent = state.appointments.filter((a: any) =>
      ["scheduled", "confirmed"].includes(a.status),
    ).length;
    $("#pendingCount").textContent = state.reminders.filter((r: any) =>
      ["pending", "processing"].includes(r.status),
    ).length;
    $("#sentCount").textContent = state.reminders.filter((r: any) => r.status === "sent").length;

    $("#patient").innerHTML =
      '<option value="">Choose a patient</option>' +
      state.patients.map((p: any) => `<option value="${p.id}">${esc(p.name)}</option>`).join("");

    $("#handoffs").innerHTML = rows(
      state.handoffs,
      (h) =>
        `<tr><td>${esc(h.caller_phone || "Unknown")}</td><td>${esc(h.reason)}</td><td>${when(h.created_at)}</td><td><span class="badge ${esc(h.status)}">${esc(h.status)}</span></td><td><button class="link-btn" data-handoff="${h.id}">Mark resolved</button></td></tr>`,
      5,
    );
    $("#appointments").innerHTML = rows(
      state.appointments,
      (a) =>
        `<tr><td>${esc(a.patient_name)}</td><td>${when(a.starts_at)}</td><td>${esc(a.clinician || "—")}</td><td>${esc(a.location || "—")}</td><td><span class="badge ${esc(a.status)}">${esc(a.status)}</span></td></tr>`,
      5,
    );
    $("#reminders").innerHTML = rows(
      state.reminders,
      (r) =>
        `<tr><td>${esc(r.patient_name)}</td><td>${esc(r.channel)}</td><td>${when(r.scheduled_for)}</td><td>${when(r.starts_at)}</td><td><span title="${esc(r.last_error || "")}" class="badge ${esc(r.status)}">${esc(r.status)}</span></td></tr>`,
      5,
    );
    $("#events").innerHTML = rows(
      state.events,
      (e) =>
        `<tr><td>${esc(e.patient_name || "Unknown")}</td><td>${esc(e.channel)}</td><td>${esc(e.outcome)}</td><td>${esc(e.detail)}</td><td>${when(e.created_at)}</td></tr>`,
      5,
    );

    $("#deliveryMode").textContent =
      state.delivery_mode === "preview"
        ? "Preview mode — no messages leave the app"
        : `Live ${state.delivery_mode} delivery`;
  }

  async function load() {
    const [overview, queue] = await Promise.all([
      api("/api/workflows/overview"),
      api("/api/workflows/handoffs").catch(() => ({ handoffs: [] })),
    ]);
    state = { ...overview, handoffs: queue.handoffs || [] };
    render();
  }

  document.addEventListener("click", async (event) => {
    const id = (event.target as HTMLElement)?.dataset?.handoff;
    if (!id) return;
    try {
      await api(`/api/workflows/handoffs/${id}`, {
        method: "PATCH",
        body: JSON.stringify({ status: "resolved" }),
      });
      await load();
      notify("Handoff resolved");
    } catch (error: any) {
      notify(error.message, true);
    }
  });

  document.querySelector("#patientForm")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    try {
      await api("/api/workflows/patients", {
        method: "POST",
        body: JSON.stringify({
          name: value("#name"),
          phone: value("#phone") || null,
          email: value("#email") || null,
          timezone: value("#timezone"),
          sms_consent: checked("#smsConsent"),
          voice_consent: checked("#voiceConsent"),
          email_consent: checked("#emailConsent"),
        }),
      });
      (event.target as HTMLFormElement).reset();
      await load();
      notify("Patient saved");
    } catch (error: any) {
      notify(error.message, true);
    }
  });

  document.querySelector("#appointmentForm")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    try {
      const result = await api("/api/workflows/appointments", {
        method: "POST",
        body: JSON.stringify({
          patient_id: Number(value("#patient")),
          starts_at: new Date(value("#startsAt")).toISOString(),
          clinician: value("#clinician"),
          location: value("#location"),
        }),
      });
      (event.target as HTMLFormElement).reset();
      await load();
      notify(
        result.reminders_created
          ? `Appointment scheduled; ${result.reminders_created} reminder${result.reminders_created === 1 ? "" : "s"} queued`
          : "Appointment scheduled. Too soon for a reminder to be useful.",
      );
    } catch (error: any) {
      notify(error.message, true);
    }
  });

  (async () => {
    try {
      const me = await api("/api/me");
      $("#username").textContent = me.full_name || me.email;
      await load();
    } catch (error: any) {
      notify(error.message, true);
    }
  })();
</script>

<style>
  main {
    max-width: 1240px;
    margin: auto;
    padding: 38px 24px 70px;
  }

  .eyebrow {
    color: var(--teal-text);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    font: clamp(2rem, 4vw, 3.2rem) var(--font-display);
    font-weight: 400;
    letter-spacing: -0.04em;
    margin: 8px 0;
  }

  .intro {
    color: var(--muted);
    max-width: 670px;
    line-height: 1.6;
    margin: 0 0 28px;
  }

  .mode {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    background: #fff8e8;
    border: 1px solid #f5d99d;
    color: #946200;
    border-radius: 999px;
    padding: 7px 11px;
    font-size: 0.76rem;
    font-weight: 700;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--amber);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin: 26px 0;
  }
  .stat {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 17px;
    box-shadow: var(--shadow-md);
    padding: 19px;
  }
  .stat strong {
    display: block;
    font: 1.9rem var(--font-display);
    font-weight: 400;
  }
  .stat span {
    color: var(--muted);
    font-size: 0.78rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 18px;
  }

  label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    display: block;
    margin: 13px 0 6px;
  }

  input,
  select {
    width: 100%;
    padding: 11px 12px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: #fbfaf8;
    font: inherit;
    font-size: 0.88rem;
    color: var(--navy);
  }
  input:focus-visible,
  select:focus-visible {
    border-color: var(--teal-text);
  }

  .consent {
    border: 0;
    padding: 0;
    margin: 0;
  }
  .consent legend {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin: 13px 0 6px;
  }

  .checks {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }
  .check {
    border: 1px solid var(--line);
    border-radius: 9px;
    padding: 9px 5px;
    font-size: 0.75rem;
    text-align: center;
    background: #fbfaf8;
    text-transform: none;
    letter-spacing: normal;
    margin: 0;
  }
  .check input {
    width: auto;
    margin-right: 3px;
  }

  button.primary {
    width: 100%;
    border: 0;
    border-radius: 10px;
    padding: 12px 14px;
    margin-top: 16px;
    background: var(--navy);
    color: var(--white);
    font-weight: 700;
    font-family: var(--font-body);
    cursor: pointer;
  }
  button.primary:hover {
    background: var(--teal);
    color: var(--navy);
  }

  .callout {
    display: flex;
    gap: 12px;
    background: var(--navy-mid);
    color: var(--white);
    border-radius: 14px;
    padding: 17px;
    margin-bottom: 18px;
  }
  .callout b {
    display: block;
    margin-bottom: 4px;
  }
  .callout small {
    color: #bac5d3;
    line-height: 1.4;
  }
  .phone {
    font-size: 1.4rem;
  }

  .toast {
    position: fixed;
    right: 24px;
    bottom: 24px;
    padding: 13px 16px;
    border-radius: 10px;
    background: var(--navy);
    color: var(--white);
    font-size: 0.84rem;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
    display: none;
  }
  .toast.error {
    background: #a61b1b;
  }

  .row2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  @media (max-width: 850px) {
    .stats {
      grid-template-columns: 1fr 1fr;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .stats {
      grid-template-columns: 1fr;
    }
    .row2 {
      grid-template-columns: 1fr;
    }
  }
</style>

<style is:global>
  /* Panel and table chrome, global because DataTable supplies the markup. */
  .panel {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 17px;
    box-shadow: var(--shadow-md);
    padding: 22px;
    margin-bottom: 18px;
  }
  .panel h2 {
    font: 1.35rem var(--font-display);
    font-weight: 400;
    margin: 0 0 5px;
  }
  .sub {
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0 0 18px;
    line-height: 1.5;
  }

  .table-wrap {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
  }
  th {
    text-align: left;
    color: var(--muted);
    font-size: 0.67rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding: 9px;
    border-bottom: 1px solid var(--line);
  }
  td {
    padding: 12px 9px;
    border-bottom: 1px solid #efede8;
    white-space: nowrap;
  }

  .badge {
    font-size: 0.67rem;
    font-weight: 700;
    padding: 4px 7px;
    border-radius: 999px;
    background: #edf0f4;
  }
  .badge.sent,
  .badge.confirmed,
  .badge.resolved {
    color: #087f5b;
    background: #e4f7ef;
  }
  .badge.pending,
  .badge.processing,
  .badge.queued {
    color: #946200;
    background: #fff4d6;
  }
  .badge.failed,
  .badge.cancelled {
    color: var(--danger);
    background: #feeceb;
  }

  .empty {
    text-align: center;
    padding: 30px;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .link-btn {
    background: none;
    border: 1px solid var(--line);
    border-radius: 7px;
    padding: 5px 10px;
    font: inherit;
    font-size: 0.78rem;
    color: var(--teal-text);
    cursor: pointer;
  }
  .link-btn:hover {
    border-color: var(--teal-text);
  }
</style>
