---
import Auth from "../layouts/Auth.astro";
---

<Auth
  title="Forgot password · moBILLity"
  heading="Reset your password"
  intro="Enter your email. If it matches an account, we’ll send a one-time link."
>
  <form id="form" class="auth-form">
    <label for="email">Email</label>
    <input class="input" id="email" type="email" autocomplete="email" required />
    <button class="button" id="submit" type="submit">Send reset link</button>
  </form>
  <p slot="footer"><a class="link" href="/login">Back to sign in</a></p>
</Auth>

<script>
  import { showAlert, payload, onSubmit } from "../lib/forms.js";

  onSubmit("#form", async () => {
    const response = await fetch("/api/forgot-password", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        email: (document.querySelector("#email") as HTMLInputElement).value.trim(),
      }),
    });
    const data = await payload(response);
    // Deliberately the same message either way — the endpoint is written to
    // avoid confirming whether an account exists.
    showAlert(data.message || data.detail, response.ok ? "success" : "error");
  });
</script>
