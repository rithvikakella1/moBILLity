---
import Base from "../layouts/Base.astro";
import MarketingNav from "../components/MarketingNav.astro";
import Footer from "../components/Footer.astro";
// Bubble and tooltip styles. Global, because the demo appends chips at
// runtime and scoped selectors would not match them.
import "../styles/results.css";
---

<Base
  title="moBILLity – AI-Powered Code Extractor"
  description="Turn clinical notes into billable ICD-10, CPT, and HCPCS codes, with consent-aware patient outreach."
>
  <MarketingNav slot="nav" />

  <div id="main">
  <!-- NAV -->
  

    <!-- HERO -->
    <section class="hero">
      <div class="hero-bg"></div>
      <div class="hero-badge">Now supporting ICD-10 & CPT codes</div>
      <h1>Medical coding,<br/><em>reimagined</em> with AI.</h1>
      <p>Automatically extract accurate ICD-10 and CPT codes from clinical notes in seconds. Built for clinicians, billers, and healthcare teams.</p>
      <div class="hero-actions">
        <a href="app.html" class="btn-primary">Launch the App</a>
        <a href="#how" class="btn-secondary">See how it works</a>
      </div>

      <div class="hero-visual">
        <div class="hero-card">
          <!-- Window chrome -->
          <div class="card-chrome">
            <div class="chrome-dot"></div>
            <div class="chrome-dot"></div>
            <div class="chrome-dot"></div>
            <span class="chrome-title">moBILLity — Live Extraction Demo</span>
          </div>

          <div class="card-body">
            <!-- Scenario label -->
            <div id="demo-scenario" class="scenario-pill">
              <span class="ai-dot"></span>
              <span id="scenario-name">Loading…</span>
            </div>

            <!-- Input label + note -->
            <div class="card-label">Clinical Note</div>
            <div class="demo-input-wrap">
              <div id="demo-note"><span class="cursor"></span></div>
            </div>

            <!-- AI progress bar -->
            <div class="ai-status-row">
              <span class="ai-status-label">AI Analysis</span>
              <div class="progress-track">
                <div class="progress-fill" id="progress-fill"></div>
              </div>
              <span class="ai-status-text" id="ai-status-text">Waiting…</span>
            </div>

            <!-- Confirmed codes -->
            <div class="card-label">Confirmed Codes <span class="label-sub">ready to bill</span></div>
            <div class="codes-row" id="codes-row"></div>

            <!-- Suggested codes -->
            <div class="suggested-section" id="suggested-section">
              <div class="card-label" style="margin-top:1.1rem;">Suggested Codes <span class="label-sub">needs clarification</span></div>
              <div class="suggested-row" id="suggested-row"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- AI CALLING ASSISTANT -->
    <section class="calling" id="calling">
      <div class="calling-layout">
        <div class="reveal">
          <span class="section-tag">AI Calling Assistant</span>
          <h2 class="section-title">Every patient call gets a clear next step.</h2>
          <p class="section-sub">Give patients a calm, always-available first point of contact. The assistant understands why they are calling, handles routine appointment questions, and routes sensitive requests to your team.</p>
          <div class="calling-points">
            <div class="calling-point"><span class="calling-check">✓</span><span>Understands natural-language requests without a maze of phone menus.</span></div>
            <div class="calling-point"><span class="calling-check">✓</span><span>Escalates billing, insurance, records, referrals, complaints, and manager requests.</span></div>
            <div class="calling-point"><span class="calling-check">✓</span><span>Keeps a consent-aware activity trail alongside appointment reminders.</span></div>
          </div>
          <a href="workflows.html" class="btn-primary">Open Workflow Hub →</a>
        </div>
        <div class="call-console reveal" aria-label="Example AI assistant call">
          <div class="call-console-head">
            <div class="call-status"><i></i> AI assistant on call</div>
            <span class="call-time">00:24</span>
          </div>
          <div class="call-transcript">
            <div class="bubble assistant">Thanks for calling Northstar Health. Tell me how I can help today.</div>
            <div class="bubble patient">I have a question about a charge on my last statement.</div>
            <div class="bubble assistant">I can connect you with the billing team. I’ll pass along the reason for your call so you don’t have to repeat it.</div>
          </div>
          <div class="route-result">
            <small>Routing decision</small>
            <strong>Billing question → Front desk handoff queued</strong>
          </div>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <div class="stats">
      <!-- Measured by tests/benchmark.py, not estimated. The label carries the
           sample size and the word "internal" on purpose: the expected codes
           have not been reviewed by a certified coder yet, so this is our own
           measurement, not an independent one. Update both the number and the
           label together after that review. -->
      <div class="stat-item">
        <div class="stat-num">93%</div>
        <div class="stat-label">Precision on our 100-case internal benchmark</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">~10s</div>
        <div class="stat-label">Average extraction time</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">70k+</div>
        <div class="stat-label">ICD-10 codes supported</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">AES-256</div>
        <div class="stat-label">Patient data encryption</div>
      </div>
    </div>

    <!-- HOW IT WORKS -->
    <section class="how" id="how">
      <div class="reveal">
        <span class="section-tag">How it works</span>
        <h2 class="section-title">From clinical note to code in three steps</h2>
        <p class="section-sub">Our AI reads clinical language the way a coder would — but 100× faster, with no fatigue.</p>
      </div>
      <div class="how-grid">
        <div class="step-card reveal">
          <div class="step-num">01</div>
          <div class="step-icon">
            <svg viewBox="0 0 24 24"><rect x="9" y="2" width="6" height="11" rx="3"/><path d="M5 10a7 7 0 0014 0"/><line x1="12" y1="19" x2="12" y2="22"/><line x1="8" y1="22" x2="16" y2="22"/></svg>
          </div>
          <h3>Dictate or paste your note</h3>
          <p>Speak directly into the app using speech-to-text, or paste any free-text clinical note, discharge summary, or SOAP note. No special formatting required.</p>
        </div>
        <div class="step-card reveal">
          <div class="step-num">02</div>
        
          <div class="step-icon">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>
          </div>
          <h3>AI extracts & maps codes</h3>
          <p>Our model identifies diagnoses, procedures, and services — then maps each to the correct ICD-10 or CPT code.</p>
        </div>
        <div class="step-card reveal">
          <div class="step-num">03</div>
          <div class="step-icon">
            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <h3>Review & export</h3>
          <p>Review the AI-generated codes, make edits if needed, and export directly to your billing system.</p>
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="features" id="features">
      <div class="features-header reveal">
        <span class="section-tag">Features</span>
        <h2 class="section-title">Everything your billing team needs</h2>
        <p class="section-sub">Powerful AI tools built specifically for the complexity of medical coding.</p>
      </div>
      <div class="features-grid">
        <div class="feature-card reveal">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 00-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0020 4.77 5.07 5.07 0 0019.91 1S18.73.65 16 2.48a13.38 13.38 0 00-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 005 4.77a5.44 5.44 0 00-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 009 18.13V22"/></svg>
          </div>
          <h3>ICD-10 & CPT Extraction</h3>
          <p>Accurately pulls both diagnosis codes (ICD-10-CM) and procedure codes (CPT) from unstructured clinical text.</p>
        </div>
        <div class="feature-card reveal">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="9" y1="9" x2="15" y2="15"/><line x1="15" y1="9" x2="9" y2="15"/></svg>
          </div>
          <h3>Confidence Scoring</h3>
          <p>Each extracted code comes with a confidence score so coders can prioritize their review where it matters most.</p>
        </div>
        <div class="feature-card reveal">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3>Documentation Guardrails</h3>
          <p>Codes below the confidence threshold are held back as suggestions with the specific documentation needed to confirm them.</p>
        </div>
        <div class="feature-card reveal">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          </div>
          <h3>Fast Enough to Use Live</h3>
          <p>Most notes return in about ten seconds — quick enough to review codes while the encounter is still open.</p>
        </div>
        <div class="feature-card reveal">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
          </div>
          <h3>EHR-Agnostic</h3>
          <p>Works with notes from any EHR — Epic, Cerner, Athena, or plain-text exports. No integration required to get started.</p>
        </div>
        <div class="feature-card reveal">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
          </div>
          <h3>Team Collaboration</h3>
          <p>Share extractions with your coding team, track edits, and maintain an audit trail for every note processed.</p>
        </div>
      </div>
    </section>

    <!-- COMPLIANCE -->
    <section class="compliance" id="compliance">
      <div class="reveal">
        <span class="section-tag" style="color:var(--teal);">Built for Healthcare</span>
        <h2 class="section-title">Security & compliance, by design</h2>
        <p class="section-sub">moBILLity is built around the security controls healthcare workflows demand — and we describe exactly where we are on the path.</p>
      </div>
      <div class="compliance-grid">
        <div class="compliance-card reveal">
          <div class="compliance-badge">🔒</div>
          <h3>Built to HIPAA Safeguards</h3>
          <p>AES-256 field encryption for patient data, TLS in transit, verified accounts, and full session revocation.</p>
        </div>
        <div class="compliance-card reveal">
          <div class="compliance-badge">🛡️</div>
          <h3>Audit-Ready Architecture</h3>
          <p>Least-privilege access, structured logging, and encrypted storage. SOC 2 assessment not yet started.</p>
        </div>
        <div class="compliance-card reveal">
          <div class="compliance-badge">🌐</div>
          <h3>Consent-Aware by Default</h3>
          <p>Per-channel patient consent is required before any reminder is sent. Preview mode ships as the default.</p>
        </div>
        <div class="compliance-card reveal">
          <div class="compliance-badge">✅</div>
          <h3>Accessible Design</h3>
          <p>Built for keyboard navigation and screen-reader use across every workflow.</p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta">
      <div class="cta-bg"></div>
      <div class="reveal">
        <span class="section-tag">Get started today</span>
        <h2 class="section-title">Ready to eliminate manual coding?</h2>
        <p class="section-sub">Join healthcare teams already saving hours every week with AI-powered code extraction.</p>
        <a href="app.html" class="btn-primary">Launch moBILLity →</a>
      </div>
    </section>

    <!-- FOOTER -->
  </div>

  <Footer slot="footer" full />
</Base>

<script>
  // ── SCROLL REVEAL ──
      const reveals = document.querySelectorAll('.reveal');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            const siblings = [...e.target.parentElement.querySelectorAll('.reveal')];
            const idx = siblings.indexOf(e.target);
            setTimeout(() => e.target.classList.add('visible'), idx * 80);
            observer.unobserve(e.target);
          }
        });
      }, { threshold: 0.1 });
      reveals.forEach(el => observer.observe(el));

      // ── LIVE DEMO ANIMATION ──
      const scenarios = [
        {
          label: 'Diabetes & Hypertension',
          note: 'Patient presents with Type 2 diabetes mellitus with diabetic nephropathy. History of essential hypertension. Prescribed metformin and lisinopril. Follow-up in 3 months.',
          confirmed: [
            { type: 'ICD', code: 'E11.65', desc: 'T2DM w/ nephropathy',     priority: 'primary',    doc: 'strong',   conf: 0.97,
              why: '"Type 2 diabetes mellitus with diabetic nephropathy" stated in the assessment.' },
            { type: 'ICD', code: 'I10',    desc: 'Essential hypertension',  priority: 'secondary',  doc: 'strong',   conf: 0.95,
              why: '"History of essential hypertension" documented.' },
            { type: 'CPT', code: '99213',  desc: 'Office visit, est.',       priority: 'procedural', doc: 'strong',   conf: 0.92,
              why: 'Established patient, follow-up visit with medication management.' },
            { type: 'CPT', code: '83036',  desc: 'HbA1c test',              priority: 'procedural', doc: 'moderate', conf: 0.84,
              why: 'HbA1c implied by diabetes management; result not recorded in the note.' },
          ],
          suggested: [
            { type: 'CPT', code: 'Z68.39', desc: 'BMI 39.0–39.9', needed: 'Document BMI measurement in the note to support coding' },
            { type: 'CPT', code: '99490',  desc: 'Chronic care management', needed: 'Confirm 20+ mins of care coordination this month' },
          ]
        },
        {
          label: 'Chest Pain Evaluation',
          note: 'Patient is a 58-year-old male presenting with acute chest pain, shortness of breath, and diaphoresis. EKG performed. Troponin ordered. Rule out NSTEMI. Administered aspirin 325 mg.',
          confirmed: [
            { type: 'ICD', code: 'R07.9',  desc: 'Chest pain, unspecified', priority: 'primary',    doc: 'strong',   conf: 0.95,
              why: '"Acute chest pain" is the presenting complaint.' },
            { type: 'ICD', code: 'R06.09', desc: 'Dyspnea, other',          priority: 'secondary',  doc: 'strong',   conf: 0.91,
              why: '"Shortness of breath" documented alongside the chest pain.' },
            { type: 'CPT', code: '93000',  desc: 'EKG w/ interpretation',   priority: 'procedural', doc: 'strong',   conf: 0.98,
              why: '"EKG performed" — procedure documented as completed.' },
            { type: 'CPT', code: '99285',  desc: 'ED visit, high severity', priority: 'procedural', doc: 'strong',   conf: 0.93,
              why: 'ED encounter with cardiac workup meets high-severity criteria.' },
          ],
          suggested: [
            { type: 'ICD', code: 'I21.4',  desc: 'NSTEMI', needed: 'Confirm NSTEMI diagnosis — currently documented as "rule out" only' },
            { type: 'CPT', code: '84484',  desc: 'Troponin, quantitative',  needed: 'Confirm troponin was resulted and interpreted, not just ordered' },
          ]
        },
        {
          label: 'Post-Op Knee Replacement',
          note: '72-year-old female, 6 weeks post total knee arthroplasty, right knee. Wound healing well. Reports mild pain controlled with acetaminophen. ROM improving. Continue PT twice weekly.',
          confirmed: [
            { type: 'ICD', code: 'Z96.651', desc: 'R knee joint prosthesis', priority: 'primary',    doc: 'strong',   conf: 0.97,
              why: '"6 weeks post total knee arthroplasty, right knee" establishes the prosthesis.' },
            { type: 'ICD', code: 'M25.361', desc: 'Stiffness, right knee',   priority: 'secondary',  doc: 'moderate', conf: 0.80,
              why: '"ROM improving" implies stiffness; degree not quantified.' },
            { type: 'CPT', code: '99213',   desc: 'Office visit, est.',       priority: 'procedural', doc: 'strong',   conf: 0.91,
              why: 'Established patient post-op follow-up with examination documented.' },
            { type: 'CPT', code: '97110',   desc: 'Therapeutic exercises',   priority: 'procedural', doc: 'moderate', conf: 0.78,
              why: '"Continue PT twice weekly" — exercise detail not documented in this note.' },
          ],
          suggested: [
            { type: 'ICD', code: 'Z96.641', desc: 'Partial knee prosthesis presence', needed: 'Clarify if partial or total arthroplasty for correct specificity' },
          ]
        },
        {
          label: 'Pediatric Asthma Visit',
          note: 'Patient is an 8-year-old with persistent moderate asthma presenting for follow-up. Using albuterol inhaler 3x/week. No ER visits since last visit. Spirometry performed. Adjusted fluticasone dose.',
          confirmed: [
            { type: 'ICD', code: 'J45.40',  desc: 'Moderate persistent asthma', priority: 'primary',    doc: 'strong',   conf: 0.96,
              why: '"Persistent moderate asthma" stated explicitly.' },
            { type: 'CPT', code: '94010',   desc: 'Spirometry',                  priority: 'procedural', doc: 'strong',   conf: 0.98,
              why: '"Spirometry performed" documented as completed.' },
            { type: 'CPT', code: '99213',   desc: 'Office visit, est.',           priority: 'procedural', doc: 'strong',   conf: 0.90,
              why: 'Established patient follow-up with spirometry and dose adjustment.' },
            { type: 'ICD', code: 'Z79.899', desc: 'Long-term inhaled steroid',   priority: 'supplemental', doc: 'strong', conf: 0.88,
              why: '"Adjusted fluticasone dose" indicates long-term inhaled steroid use.' },
          ],
          suggested: [
            { type: 'CPT', code: '94060', desc: 'Spirometry pre/post bronchodilator', needed: 'Was bronchodilator given before spirometry? Document to support upgraded code' },
            { type: 'ICD', code: 'Z82.5', desc: 'Family history of asthma',           needed: 'Document family history if applicable for completeness' },
          ]
        },
      ];

      let currentScenario = 0;

      const noteEl        = document.getElementById('demo-note');
      const codesRow      = document.getElementById('codes-row');
      const suggestedRow  = document.getElementById('suggested-row');
      const progressFill  = document.getElementById('progress-fill');
      const statusText    = document.getElementById('ai-status-text');
      const scenarioName  = document.getElementById('scenario-name');

      const TYPING_SPEED       = 22;
      const PAUSE_AFTER        = 600;
      const ANALYSIS_DURATION  = 1800;
      const HOLD_DURATION      = 3800;
      const RESET_DURATION     = 500;

      function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

      function priorityClass(p) {
        return { primary: 'priority-primary', secondary: 'priority-secondary', procedural: 'priority-procedural', supplemental: 'priority-supplemental' }[p] || '';
      }
      function docClass(d) {
        return { strong: 'doc-strong', moderate: 'doc-moderate', weak: 'doc-weak' }[d] || '';
      }

      async function runDemo() {
        while (true) {
          const s = scenarios[currentScenario];
          currentScenario = (currentScenario + 1) % scenarios.length;

          // Reset
          codesRow.innerHTML    = '';
          suggestedRow.innerHTML = '';
          progressFill.style.transition = 'none';
          progressFill.style.width = '0%';
          statusText.textContent = 'Waiting…';
          statusText.style.color = 'var(--text-light)';
          scenarioName.textContent = s.label;

          // Typewriter
          noteEl.innerHTML = '<span class="cursor"></span>';
          const chars = s.note.split('');
          for (let i = 0; i < chars.length; i++) {
            const cursor = noteEl.querySelector('.cursor');
            if (noteEl.firstChild && noteEl.firstChild.nodeType === Node.TEXT_NODE) {
              noteEl.firstChild.textContent += chars[i];
            } else {
              noteEl.insertBefore(document.createTextNode(chars[i]), cursor);
            }
            await sleep(TYPING_SPEED);
          }

          await sleep(PAUSE_AFTER);

          // Progress bar
          statusText.textContent = 'Analyzing…';
          statusText.style.color = 'var(--teal)';
          progressFill.style.transition = `width ${ANALYSIS_DURATION}ms cubic-bezier(0.4,0,0.2,1)`;
          progressFill.style.width = '100%';

          // Confirmed code chips
          const totalItems = s.confirmed.length + s.suggested.length;
          const chipDelay  = ANALYSIS_DURATION / (totalItems + 1);

          s.confirmed.forEach((c, i) => {
            const chip = document.createElement('div');
            chip.className = 'code-chip codechip-wrap';
            const pct = Math.round(c.conf * 100);
            const tier = c.conf >= 0.9 ? 'high' : c.conf >= 0.8 ? 'med' : 'low';
            const family = c.type === 'ICD' ? 'icd' : c.type === 'CPT' ? 'cpt' : 'hcpcs';
            chip.innerHTML = `
              <button type="button" class="codechip codechip--${tier}" style="--conf:${pct}"
                      aria-describedby="demo-tip-${i}">
                <span class="codechip__system" data-system="${family}">${c.type}</span>
                <span class="codechip__code">${c.code}</span>
                <span class="codechip__conf" aria-hidden="true"></span>
              </button>
              <div class="tip" id="demo-tip-${i}" role="tooltip">
                <div class="tip__desc">${c.desc}</div>
                ${c.why ? `<span class="tip__label">Supporting documentation</span>
                <div class="tip__reason">${c.why}</div>` : ''}
                <div class="tip__meta">
                  <span class="tip__pill">${c.priority}</span>
                  <span class="tip__pill tip__pill--${c.doc}">${c.doc} documentation</span>
                  <span class="tip__pill">${pct}% confidence</span>
                </div>
              </div>`;
            codesRow.appendChild(chip);
            setTimeout(() => chip.classList.add('visible'), chipDelay * (i + 1));
          });

          // Suggested chips (staggered after confirmed)
          s.suggested.forEach((sg, i) => {
            const chip = document.createElement('div');
            chip.className = 'suggested-chip codechip-wrap';
            const sgFamily = sg.type === 'ICD' ? 'icd' : sg.type === 'CPT' ? 'cpt' : 'hcpcs';
            chip.innerHTML = `
              <button type="button" class="codechip codechip--suggested"
                      aria-describedby="demo-sug-${i}">
                <span class="codechip__system" data-system="${sgFamily}">${sg.type}</span>
                <span class="codechip__code">${sg.code}</span>
                <span class="codechip__query" aria-hidden="true">?</span>
              </button>
              <div class="tip" id="demo-sug-${i}" role="tooltip">
                <div class="tip__desc">${sg.desc}</div>
                <div class="tip__needed">
                  <span class="tip__label tip__label--warn">Documentation needed</span>
                  ${sg.needed}
                </div>
              </div>`;
            suggestedRow.appendChild(chip);
            setTimeout(() => chip.classList.add('visible'), chipDelay * (s.confirmed.length + i + 1));
          });

          await sleep(ANALYSIS_DURATION);

          statusText.textContent = '✓ Complete';
          statusText.style.color = 'var(--teal)';

          await sleep(HOLD_DURATION);

          // Fade out
          [...codesRow.querySelectorAll('.code-chip'), ...suggestedRow.querySelectorAll('.suggested-chip')].forEach((c) => {
            if (!(c instanceof HTMLElement)) return;
            c.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
            c.style.opacity = '0';
            c.style.transform = 'translateY(-6px)';
          });

          progressFill.style.transition = `width ${RESET_DURATION}ms ease`;
          progressFill.style.width = '0%';

          const fullText = noteEl.firstChild?.textContent || '';
          let len = fullText.length;
          const eraseInterval = setInterval(() => {
            len -= 5;
            if (len <= 0) {
              clearInterval(eraseInterval);
              noteEl.innerHTML = '<span class="cursor"></span>';
            } else {
              if (noteEl.firstChild && noteEl.firstChild.nodeType === Node.TEXT_NODE) {
                noteEl.firstChild.textContent = fullText.slice(0, len);
              }
            }
          }, 16);

          await sleep(RESET_DURATION + 200);
        }
      }

