# Copy to .env for local development. Never commit the filled-in file.
# Every variable the application reads is listed here.

# ── Core ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development                 # 'production' enforces the required secrets below
LOG_LEVEL=INFO

# ── Secrets (required in production) ─────────────────────────────────────────
JWT_SECRET_KEY=                         # at least 32 random bytes
SESSION_SECRET_KEY=                     # a different random value
# Must decode to exactly 32 bytes and stay identical across deploys, or stored
# patient data becomes unreadable. Generate with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=
# Optional. Derived from ENCRYPTION_KEY when unset.
PHONE_HMAC_KEY=
COOKIE_SECURE=false                     # true in production

# ── Database ─────────────────────────────────────────────────────────────────
# Set DATABASE_URL for PostgreSQL; leave empty to use the local SQLite file.
DATABASE_URL=
DATABASE_FILE=users.db
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── Extraction ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Authentication email ─────────────────────────────────────────────────────
# Brevo's HTTPS API is preferred when set, for hosts that block SMTP ports.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=moBILLity
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@mobillity.local
# Development only: writes verification links to the server log.
AUTH_DEV_SHOW_LINKS=true

# ── Google sign-in ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Admin and privacy ────────────────────────────────────────────────────────
ADMIN_EMAILS=                           # comma-separated verified account emails
PRIVACY_CONTACT_EMAIL=privacy@example.com
ANALYTICS_RETENTION_DAYS=90
ACCESS_TOKEN_EXPIRE_MINUTES=60
ACTION_TOKEN_EXPIRE_MINUTES=60

# ── Patient communication ────────────────────────────────────────────────────
PRACTICE_NAME=Example Health
# 'preview' never contacts a patient. Set 'live' only when you mean it.
COMMUNICATION_DELIVERY_MODE=preview
DEFAULT_PATIENT_TIMEZONE=America/New_York
REMINDER_LEAD_DAYS=7
REMINDER_SHORT_NOTICE_HOURS=24
REMINDER_MINIMUM_NOTICE_HOURS=2

# ── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FRONT_DESK_PHONE_NUMBER=
# Development only. Accepting unsigned webhooks must be requested by name.
TWILIO_SKIP_SIGNATURE_CHECK=false

# ── Background dispatcher ────────────────────────────────────────────────────
# Must be true on exactly one process. Two dispatchers send duplicate reminders.
WORKFLOW_WORKER=false
